{
"manifest_version": 3,
"name": "Youtube Shorts Counter",
"version": "1.0",
"description": "유튜브 쇼츠 시청 개수를 카운트하고 알림을 주는 도구",
"permissions": ["storage", "tabs", "notifications"],
"action": {
"default_popup": "popup.html"
},
"background": {
"service_worker": "background.js"
},
"icons": {
"128": "icon.png"
}
}